{
  "name": "fridgemanager",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start",
    "start:dev:verbose": "expo start --verbose",
    "start:prod": "expo start --no-dev --minify",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:unit": "jest --testPathPattern=__tests__",
    "test:detox:build": "detox build --configuration android.emu.debug",
    "test:detox:build:ci": "detox build --configuration android.emu.ci",
    "test:detox:test": "detox test --configuration android.emu.debug",
    "test:detox:test:ci": "detox test --configuration android.emu.ci --record-logs failing --take-screenshots failing",
    "test:detox:ios:build": "detox build --configuration ios.sim.debug",
    "test:detox:ios:test": "detox test --configuration ios.sim.debug",
    "test:all": "npm run test:unit && npm run test:detox:test",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf node_modules && npm install",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "expo": "~54.0.0",
    "expo-auth-session": "~7.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-device": "~8.0.10",
    "expo-modules-core": "^3.0.22",
    "expo-notifications": "~0.32.17",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~2.2.3",
    "expo-web-browser": "~15.0.10",
    "firebase": "^12.11.0",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "~5.4.0",
    "react-native-screens": "~4.11.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/cli": "0.18.16",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.0.10",
    "@types/react-test-renderer": "^18.0.7",
    "detox": "^20.44.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^9.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.10",
    "patch-package": "^8.0.1",
    "prettier": "^3.2.5",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3"
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.(js|jsx|ts|tsx)",
      "**/*.(test|spec).(js|jsx|ts|tsx)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "app/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts",
      "!app/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "detox": {
    "testRunner": {
      "args": {
        "$0": "jest",
        "config": "e2e/config.json"
      },
      "jest": {
        "setupFilesAfterEnv": [
          "<rootDir>/e2e/init.js"
        ]
      }
    },
    "apps": {
      "android.debug": {
        "type": "android.apk",
        "binaryPath": "android/app/build/outputs/apk/debug/app-debug.apk",
        "build": "cd android && ./gradlew assembleDebug assembleAndroidTest -DtestBuildType=debug",
        "reversePorts": [
          {
            "host": 8081,
            "device": 8081
          }
        ]
      },
      "android.release": {
        "type": "android.apk",
        "binaryPath": "android/app/build/outputs/apk/release/app-release.apk",
        "testBinaryPath": "android/app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk",
        "build": "cd android && ./gradlew assembleRelease assembleDebugAndroidTest"
      },
      "android.ci": {
        "type": "android.apk",
        "binaryPath": "android/app/build/outputs/apk/debug/app-debug.apk",
        "testBinaryPath": "android/app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk",
        "build": "cd android && ./gradlew assembleDebug assembleDebugAndroidTest -PdetoxCI=true"
      },
      "ios.debug": {
        "type": "ios.app",
        "binaryPath": "ios/build/Build/Products/Debug-iphonesimulator/FridgeManager.app",
        "build": "cd ios && xcodebuild -workspace FridgeManager.xcworkspace -scheme FridgeManager -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build",
        "reversePorts": [
          {
            "host": 8081,
            "device": 8081
          }
        ]
      }
    },
    "devices": {
      "simulator": {
        "type": "ios.simulator",
        "device": {
          "type": "iPhone 14"
        }
      },
      "emulator": {
        "type": "android.emulator",
        "device": {
          "avdName": "Pixel_5_API_33"
        }
      },
      "attached": {
        "type": "android.attached",
        "device": {
          "adbName": ".*"
        }
      }
    },
    "configurations": {
      "ios.sim.debug": {
        "device": "simulator",
        "app": "ios.debug"
      },
      "android.emu.debug": {
        "device": "emulator",
        "app": "android.debug"
      },
      "android.att.debug": {
        "device": "attached",
        "app": "android.debug"
      },
      "android.att.release": {
        "device": "attached",
        "app": "android.release"
      },
      "android.att.ci": {
        "device": "attached",
        "app": "android.ci"
      },
      "android.emu.ci": {
        "device": "emulator",
        "app": "android.ci"
      }
    }
  },
  "private": true
}
