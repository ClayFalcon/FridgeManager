{
  "name": "fridgemanager",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start",
    "start:dev:verbose": "expo start --verbose",
    "start:prod": "expo start --no-dev --minify",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:unit": "jest --testPathPattern=__tests__",
    "test:detox:build": "detox build --configuration android.emu.debug",
    "test:detox:test": "detox test --configuration android.emu.debug",
    "test:detox:build:ci": "detox build --configuration android.emu.debug.ci",
    "test:detox:test:ci": "detox test --configuration android.emu.debug.ci",
    "test:detox:emulator:build": "detox build --configuration android.emu.debug",
    "test:detox:emulator:test": "node scripts/test-emulator.js",
    "test:detox:device:build": "detox build --configuration android.att.debug",
    "test:detox:device:test": "detox test --configuration android.att.debug",
    "test:detox:ios:build": "detox build --configuration ios.sim.debug",
    "test:detox:ios:test": "detox test --configuration ios.sim.debug",
    "test:all": "npm run test:unit && npm run test:detox:test",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf node_modules && npm install"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-modules-core": "^3.0.22",
    "expo-status-bar": "~2.2.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.4.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/cli": "0.18.16",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.2.2",
    "@types/react-test-renderer": "^18.0.7",
    "detox": "^20.44.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^9.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.10",
    "prettier": "^3.2.5",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.8.3"
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.(js|jsx|ts|tsx)",
      "**/*.(test|spec).(js|jsx|ts|tsx)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "app/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts",
      "!app/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "detox": {
    "testRunner": {
      "args": {
        "$0": "jest",
        "config": "e2e/config.json"
      },
      "jest": {
        "setupFilesAfterEnv": [
          "<rootDir>/e2e/init.js"
        ]
      }
    },
    "apps": {
      "android.debug": {
        "type": "android.apk",
        "binaryPath": "android/app/build/outputs/apk/debug/app-debug.apk",
        "build": "cd android && gradlew.bat assembleDebug assembleAndroidTest -DtestBuildType=debug"
      },
      "ios.debug": {
        "type": "ios.app",
        "binaryPath": "ios/build/Build/Products/Debug-iphonesimulator/FridgeManager.app",
        "build": "cd ios && xcodebuild -workspace FridgeManager.xcworkspace -scheme FridgeManager -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build"
      }
    },
    "devices": {
      "simulator": {
        "type": "ios.simulator",
        "device": {
          "type": "iPhone 14"
        }
      },
      "emulator": {
        "type": "android.emulator",
        "device": {
          "avdName": "Medium_Phone_API_36.0"
        },
        "coldBoot": false,
        "gpuMode": "auto"
      },
      "emulator-ci": {
        "type": "android.emulator",
        "device": {
          "avdName": "test_avd"
        },
        "coldBoot": false,
        "gpuMode": "swiftshader_indirect"
      },
      "attached": {
        "type": "android.attached",
        "device": {
          "adbName": ".*"
        }
      }
    },
    "configurations": {
      "ios.sim.debug": {
        "device": "simulator",
        "app": "ios.debug"
      },
      "android.emu.debug": {
        "device": "emulator",
        "app": "android.debug"
      },
      "android.emu.debug.ci": {
        "device": "emulator-ci",
        "app": "android.debug"
      },
      "android.att.debug": {
        "device": "attached",
        "app": "android.debug"
      }
    }
  },
  "private": true
}
