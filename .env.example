# Google OAuth Client IDs
# 取得手順:
#   1. Firebase Console → Authentication → Sign-in method → Google を有効化
#   2. Google Cloud Console → API と サービス → 認証情報
#   3. Web Client ID: 「OAuth 2.0 クライアント ID」の種類が「ウェブ アプリケーション」のもの
#   4. Android Client ID: 「OAuth 2.0 クライアント ID」の種類が「Android」のもの
#      ※ 事前に Firebase Console の Android アプリに SHA-1 フィンガープリントを登録すること
#         (debug: keytool -list -v -keystore ~/.android/debug.keystore -alias androiddebugkey -storepass android -keypass android)

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
