# リリース署名の設定テンプレート。
# このファイルをコピーして android/keystore.properties を作成し、実際の値を記入する。
# android/keystore.properties は .gitignore 済み（絶対にコミットしないこと）。
#
# storeFile は android/ ディレクトリからの相対パス。
# 例: キーストアを android/app/upload-keystore.jks に置いた場合は app/upload-keystore.jks

storeFile=app/upload-keystore.jks
storePassword=ここにキーストアのパスワード
keyAlias=upload
keyPassword=ここに鍵のパスワード
